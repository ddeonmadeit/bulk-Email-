# ─── Gmail SMTP ───────────────────────────────────────────────────────────────
# DO NOT use your real Gmail password here.
# You need a Gmail App Password — see setup steps below.
#
# HOW TO GET A GMAIL APP PASSWORD:
#   1. Go to https://myaccount.google.com/security
#   2. Enable 2-Step Verification if not already on
#   3. Go to https://myaccount.google.com/apppasswords
#   4. Click "Select app" → choose "Mail"
#   5. Click "Select device" → choose "Other" → type "Bulk Emailer"
#   6. Click Generate — copy the 16-character password shown
#   7. Paste it as SMTP_PASS below (no spaces)
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# ─── Sender Identity ──────────────────────────────────────────────────────────
FROM_NAME=Deon
FROM_EMAIL=you@gmail.com
REPLY_TO=you@gmail.com

# ─── Email Content ────────────────────────────────────────────────────────────
EMAIL_SUBJECT=Playlist Submission
TEMPLATE_TEXT=templates/email.txt
TEMPLATE_HTML=templates/email.html
UNSUBSCRIBE_URL=

# ─── CSV Input ────────────────────────────────────────────────────────────────
CSV_FILE=contacts.csv

# ─── Rate Limiting & Anti-Spam Timing ─────────────────────────────────────────
DELAY_MIN_SEC=3
DELAY_MAX_SEC=8
BATCH_SIZE=20
BATCH_BREAK_SEC=300
DAILY_LIMIT=200

# ─── Output ───────────────────────────────────────────────────────────────────
LOG_FILE=logs/send_log.csv
