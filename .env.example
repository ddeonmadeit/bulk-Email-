# ─── SMTP Configuration ───────────────────────────────────────────────────────
# Gmail example: smtp.gmail.com (use an App Password, not your real password)
# Outlook:       smtp-mail.outlook.com
# SendGrid:      smtp.sendgrid.net  (user = "apikey", pass = your API key)
# Mailgun:       smtp.mailgun.org
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false          # true = port 465 (SSL), false = port 587 (STARTTLS)
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password-here

# ─── Sender Identity ──────────────────────────────────────────────────────────
FROM_NAME=Your Name
FROM_EMAIL=you@gmail.com
REPLY_TO=you@gmail.com

# ─── Email Content ────────────────────────────────────────────────────────────
EMAIL_SUBJECT=Your subject line here
# Path to plain-text template  (use {{name}}, {{email}}, {{company}} as placeholders)
TEMPLATE_TEXT=templates/email.txt
# Path to HTML template (optional — leave blank to send text-only)
TEMPLATE_HTML=templates/email.html
# A publicly accessible URL to your unsubscribe page / mailto link
UNSUBSCRIBE_URL=https://yourdomain.com/unsubscribe

# ─── CSV Input ────────────────────────────────────────────────────────────────
CSV_FILE=contacts.csv

# ─── Rate Limiting & Anti-Spam Timing ─────────────────────────────────────────
# Minimum seconds to wait between individual emails
DELAY_MIN_SEC=3
# Maximum seconds to wait between individual emails (random value in this range)
DELAY_MAX_SEC=8
# How many emails to send before taking a longer "batch break"
BATCH_SIZE=20
# Seconds to wait between batches (default: 5 minutes)
BATCH_BREAK_SEC=300
# Maximum emails to send per run (0 = no limit)
DAILY_LIMIT=200

# ─── Output ───────────────────────────────────────────────────────────────────
# File where sent/failed results are logged
LOG_FILE=logs/send_log.csv
